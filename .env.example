# Firebase Web configuration is public, but no real values are committed.
# Register/verify a Firebase Web App in pianta-db and fill these in a local .env.
# OAuth provider: authorize https://piante.web.app/__/auth/handler and piante.web.app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=pianta-db
VITE_FIREBASE_AUTH_DOMAIN=piante.web.app

# CLOSED BY DEFAULT. Never open account creation to the public by accident.
VITE_AUTH_TEST_MODE=false
