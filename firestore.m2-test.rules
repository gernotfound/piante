// M2 test-only rules. NEVER deploy to pianta-db: existing legacy users/{uid} need preservation.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function invitedOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/piante_access/$(uid))
        && get(/databases/$(database)/documents/piante_access/$(uid)).data.enabled == true;
    }
    function validPlantDraft(p) {
      return p is map
        && p.keys().hasOnly([
          'id', 'commonName', 'scientificName', 'cultivar', 'origin', 'status',
          'sownOn', 'acquiredOn', 'motherId', 'fatherId', 'placeId', 'potLiters',
          'soilPhMin', 'soilPhMax', 'minimumTemperatureC', 'notes', 'purchasePrice'
        ])
        && p.keys().hasAll(['id', 'commonName', 'origin', 'status'])
        && p.id is string && p.id.size() <= 96 && p.commonName is string && p.commonName.size() <= 120
        && p.origin in ['seed', 'cutting', 'graft', 'purchased', 'unknown']
        && p.status in ['active', 'archived', 'dead'];
    }
    function validPlaceDraft(p) {
      return p is map && p.keys().hasOnly(['id', 'name', 'kind', 'latitude', 'longitude', 'notes'])
        && p.keys().hasAll(['id', 'name', 'kind'])
        && p.id is string && p.id.size() <= 96
        && p.name is string && p.name.size() <= 120
        && p.kind in ['balcony', 'garden', 'indoor', 'greenhouse', 'other'];
    }
    function validEventDraft(e) {
      return e is map
        && e.keys().hasOnly(['id', 'plantId', 'date', 'type', 'note', 'heightCm', 'soilPh', 'harvestGrams'])
        && e.keys().hasAll(['id', 'plantId', 'date', 'type'])
        && e.id is string && e.id.size() <= 96
        && e.plantId is string && e.plantId.size() <= 96
        && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}
    match /piante_access/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /piante_users/{uid} {
      allow get: if invitedOwner(uid);
      allow list, create, update, delete: if false;
      // Laboratory-only append-only transport: not a live permissions release.
      match /operations/{operationId} {
        allow get, list: if invitedOwner(uid);
        allow create: if invitedOwner(uid) && validCloudJournal(uid, operationId);
        allow update, delete: if false;
      }
      match /{path=**} {
        allow get, list: if invitedOwner(uid);
        allow create, update, delete: if false;
      }
    }
    // No public catalog or legacy grants in these test-only rules.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
)
        && e.type in ['observation', 'care', 'measurement', 'flowering', 'fruiting', 'harvest'];
    }
    function validPlantPatch(p) {
      return p is map && p.keys().size() > 0
        && p.keys().hasOnly([
          'commonName', 'scientificName', 'cultivar', 'origin', 'status',
          'sownOn', 'acquiredOn', 'motherId', 'fatherId', 'placeId', 'potLiters',
          'soilPhMin', 'soilPhMax', 'minimumTemperatureC', 'notes', 'purchasePrice'
        ]);
    }
    function validPlacePatch(p) {
      return p is map && p.keys().size() > 0
        && p.keys().hasOnly(['name', 'kind', 'latitude', 'longitude', 'notes']);
    }
    function validIntent(op) {
      return op is map && op.keys().hasAll(['type'])
        && (
          (op.type == 'plant.create' && op.keys().hasOnly(['type', 'plant'])
            && op.keys().hasAll(['plant']) && validPlantDraft(op.plant))
          || (op.type == 'place.create' && op.keys().hasOnly(['type', 'place'])
            && op.keys().hasAll(['place']) && validPlaceDraft(op.place))
          || (op.type == 'event.add' && op.keys().hasOnly(['type', 'event'])
            && op.keys().hasAll(['event']) && validEventDraft(op.event))
          || (op.type == 'plant.patch' && op.keys().hasOnly(['type', 'id', 'patch'])
            && op.keys().hasAll(['id', 'patch']) && op.id is string
            && validPlantPatch(op.patch))
          || (op.type == 'place.patch' && op.keys().hasOnly(['type', 'id', 'patch'])
            && op.keys().hasAll(['id', 'patch']) && op.id is string
            && validPlacePatch(op.patch))
        );
    }
    function validCloudJournal(uid, id) {
      let d = request.resource.data;
      return d.keys().hasAll(['protocol', 'ownerUid', 'operationId', 'replicaId',
                               'sequence', 'appliedAt', 'operation'])
        && d.keys().hasOnly(['protocol', 'ownerUid', 'operationId', 'replicaId',
                             'sequence', 'appliedAt', 'operation'])
        && d.protocol == 1 && d.ownerUid == uid && d.operationId == id
        && d.replicaId is string && d.replicaId.matches('^[0-9a-f-]{36}
    match /piante_access/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /piante_users/{uid} {
      allow get: if invitedOwner(uid);
      allow list, create, update, delete: if false;
      // Laboratory-only append-only transport: not a live permissions release.
      match /operations/{operationId} {
        allow get, list: if invitedOwner(uid);
        allow create: if invitedOwner(uid) && validCloudJournal(uid, operationId);
        allow update, delete: if false;
      }
      match /{path=**} {
        allow get, list: if invitedOwner(uid);
        allow create, update, delete: if false;
      }
    }
    // No public catalog or legacy grants in these test-only rules.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
)
        && d.sequence is int && d.sequence > 0 && d.sequence < 2000000000
        && d.appliedAt is int && d.appliedAt >= 0
        && validIntent(d.operation);
    }
    // Admin-only provisioning. Clients may inspect their own grant, never create or edit it.
    match /piante_access/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /piante_users/{uid} {
      allow get: if invitedOwner(uid);
      allow list, create, update, delete: if false;
      // Laboratory-only append-only transport: not a live permissions release.
      match /operations/{operationId} {
        allow get, list: if invitedOwner(uid);
        allow create: if invitedOwner(uid) && validCloudJournal(uid, operationId);
        allow update, delete: if false;
      }
      match /{path=**} {
        allow get, list: if invitedOwner(uid);
        allow create, update, delete: if false;
      }
    }
    // No public catalog or legacy grants in these test-only rules.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
