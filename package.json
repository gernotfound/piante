{
  "name": "piante",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "icons:generate": "node scripts/resize-icons.mjs",
    "predev": "npm run icons:generate",
    "dev": "vite",
    "prebuild": "npm run check:release-boundary && npm run icons:generate",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tests vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run test && npm run build",
    "test:rules": "node scripts/run-firestore-rules-tests.mjs",
    "check:release-boundary": "node scripts/check-release-boundary.mjs",
    "test:release-boundary": "node --test scripts/release-boundary.test.mjs",
    "test:rules:compat": "node --test scripts/compose-compat-rules.test.mjs && node scripts/run-firestore-rules-tests.mjs --compat"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.87.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "fake-indexeddb": "6.2.5",
    "@firebase/rules-unit-testing": "5.0.2"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0",
    "jwks-rsa": {
      "jose": "5.10.0"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.8.1",
    "source-map-js": "1.2.2"
  },
  "allowScripts": {
    "@firebase/util": true,
    "protobufjs": true,
    "re2": true
  }
}
