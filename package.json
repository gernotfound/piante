{
  "name": "piantee",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "build": "node scripts/build-cloudflare-site.mjs",
    "test": "node --test tests/unit/*.test.js tests/contracts/*.test.js",
    "test:browser": "node --test tests/e2e/cloudflare-site.test.js",
    "test:cloudflare": "node --test tests/native/cloudflare-runtime.test.js",
    "build:cloudflare:cf": "node scripts/prepare-cloudflare-cf.mjs && vite build && node scripts/assemble-cloudflare-output.mjs && cf workers check --prebuilt"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "cf": "1.0.0-beta.31",
    "@cloudflare/vite-plugin": "2.0.0-rc.0",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
